# CodeAtlas Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database
# Default to SQLite for easy local dev; use PostgreSQL in production/Docker
DATABASE_URL=sqlite+aiosqlite:///./codeatlas.db
# DATABASE_URL=postgresql+asyncpg://codeatlas:codeatlas@localhost:5432/codeatlas

# Redis & Job Queue
REDIS_URL=redis://localhost:6379/0

# Storage & Sandboxing
WORKSPACE_ROOT=./sandbox/workspaces
MAX_REPO_SIZE_MB=250
MAX_FILES_PER_REPO=10000
ANALYSIS_TIMEOUT_SECONDS=300
GIT_CLONE_TIMEOUT_SECONDS=60

# LLM / AI Configuration (Optional)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
